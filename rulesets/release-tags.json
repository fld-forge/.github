{
  "name": "release-tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/v*"],
      "exclude": []
    },
    "repository_name": {
      "include": ["~ALL"],
      "exclude": [],
      "protected": false
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "update"},
    {"type": "non_fast_forward"}
  ],
  "bypass_actors": []
}
